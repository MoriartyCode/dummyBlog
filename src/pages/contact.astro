---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Contact — Lumen Studio" description="Get in touch with Lumen Studio to start your next design project." />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Let's talk.</h1>
				<p>Tell us about your project and we'll get back to you within one business day.</p>
			</section>

			<section class="contact-body">
				<div class="contact-grid">
					<div class="contact-info">
						<h2>Get in touch</h2>

						<div class="info-block">
							<h3>Email</h3>
							<p>hello@lumenstudio.co</p>
						</div>

						<div class="info-block">
							<h3>Phone</h3>
							<p>+1 (415) 555-0182</p>
						</div>

						<div class="info-block">
							<h3>Studio</h3>
							<p>
								248 Design District Blvd<br />
								San Francisco, CA 94107<br />
								United States
							</p>
						</div>

						<div class="info-block">
							<h3>Office hours</h3>
							<p>Monday – Friday, 9 am – 6 pm PT</p>
						</div>
					</div>

					<div class="contact-form">
						<h2>Send a message</h2>
						<p class="form-note">This is a placeholder form — wire up your preferred backend or form service.</p>

						<form>
							<div class="field">
								<label for="name">Name</label>
								<input type="text" id="name" name="name" placeholder="Your name" />
							</div>
							<div class="field">
								<label for="email">Email</label>
								<input type="email" id="email" name="email" placeholder="you@example.com" />
							</div>
							<div class="field">
								<label for="project">Project type</label>
								<select id="project" name="project">
									<option value="">Select one...</option>
									<option value="ux">UI/UX Design</option>
									<option value="dev">Web Development</option>
									<option value="brand">Branding</option>
									<option value="other">Other</option>
								</select>
							</div>
							<div class="field">
								<label for="message">Message</label>
								<textarea id="message" name="message" rows="5" placeholder="Tell us about your project — scope, timeline, budget range..."></textarea>
							</div>
							<button type="submit" class="btn">Send message</button>
						</form>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		padding: 0;
		margin: 0;
	}

	.page-header {
		max-width: 720px;
		margin: 0 auto;
		padding: 5em 2em 3em;
	}

	.page-header h1 {
		margin-bottom: 0.5rem;
	}

	.page-header p {
		color: rgb(var(--gray));
		font-size: 1.1rem;
	}

	.contact-body {
		padding: 2em 2em 6em;
	}

	.contact-grid {
		max-width: 960px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1.6fr;
		gap: 4rem;
	}

	.contact-info h2,
	.contact-form h2 {
		margin-bottom: 2rem;
	}

	.info-block {
		margin-bottom: 2rem;
	}

	.info-block h3 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgb(var(--gray));
		margin-bottom: 0.25rem;
	}

	.info-block p {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 1rem;
		line-height: 1.6;
	}

	.form-note {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin-bottom: 1.5rem;
		font-style: italic;
	}

	.field {
		display: flex;
		flex-direction: column;
		margin-bottom: 1.25rem;
	}

	label {
		font-size: 0.9rem;
		font-weight: 700;
		margin-bottom: 0.4rem;
		color: rgb(var(--gray-dark));
	}

	input,
	select,
	textarea {
		padding: 0.6em 0.8em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		font-size: 1rem;
		font-family: var(--font-atkinson);
		color: rgb(var(--gray-dark));
		background: #fff;
	}

	input:focus,
	select:focus,
	textarea:focus {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
		border-color: transparent;
	}

	textarea {
		resize: vertical;
	}

	.btn {
		display: inline-block;
		padding: 0.75em 2em;
		background: var(--accent);
		color: #fff;
		text-decoration: none;
		border-radius: 4px;
		font-size: 1rem;
		font-weight: 700;
		border: none;
		cursor: pointer;
		margin-top: 0.5rem;
	}

	.btn:hover {
		background: var(--accent-dark);
	}

	@media (max-width: 720px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}
</style>
